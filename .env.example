# YouTube Second Brain — Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API key (get free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Absolute path to your local clone of the GitHub knowledge base repo
# Example: C:/Users/YourName/youtube-second-brain
GITHUB_REPO_PATH=C:/Users/YourName/youtube-second-brain

# (Optional) YouTube playlist ID for your "Second Brain Queue" playlist
# Find it in the playlist URL after "list="
# Leave empty if you don't use a dedicated playlist
SECOND_BRAIN_PLAYLIST_ID=

# Path to your exported YouTube cookies file (Netscape format)
# Default: cookies.txt in the project directory
COOKIE_FILE_PATH=cookies.txt
